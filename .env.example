# n8n Popularity Collector - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# API Keys (Optional - app runs in demo mode without these)
# ============================================================================

# YouTube Data API v3 Key
# Get from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes needed: public_repo (or leave empty for lower rate limits)
GITHUB_TOKEN=

# ============================================================================
# Application Configuration
# ============================================================================

# Run mode: 'live' uses real APIs, 'demo' uses mocked data
# Automatically switches to 'demo' if API keys are missing
RUN_MODE=live

# Maximum concurrent operations (adjust based on your system)
CONCURRENCY=10

# Cache TTL in seconds (3600 = 1 hour)
CACHE_TTL=3600

# ============================================================================
# Rate Limiting Configuration (Advanced)
# ============================================================================

# YouTube API rate limit (requests per time window)
# Default: 100 requests per 100 seconds
# YOUTUBE_RATE_LIMIT=100
# YOUTUBE_RATE_WINDOW=100

# GitHub API rate limit
# Authenticated: 5000/hour, Unauthenticated: 60/hour
# GITHUB_RATE_LIMIT=60
# GITHUB_RATE_WINDOW=3600

# Reddit API rate limit
# REDDIT_RATE_LIMIT=60
# REDDIT_RATE_WINDOW=60

# Google Trends rate limit (very conservative)
# TRENDS_RATE_LIMIT=1
# TRENDS_RATE_WINDOW=5

# ============================================================================
# Server Configuration
# ============================================================================

# Server host and port (for uvicorn)
HOST=127.0.0.1
PORT=8000

# Log level: debug, info, warning, error
LOG_LEVEL=info

# ============================================================================
# Data Collection Configuration
# ============================================================================

# Query keywords for data collection (comma-separated)
QUERY_KEYWORDS=n8n workflow automation,n8n google sheets slack,n8n workflow tutorial,n8n integration,n8n automation examples

# Output directory for JSON files
OUTPUT_DIR=./output

# Cache directory
CACHE_DIR=./cache

# Maximum entries per source (0 = unlimited)
MAX_ENTRIES_PER_SOURCE=0

# ============================================================================
# Example with API Keys (uncomment and fill in)
# ============================================================================

# YOUTUBE_API_KEY=
# GITHUB_TOKEN=
# RUN_MODE=live
# CONCURRENCY=20
# CACHE_TTL=7200
